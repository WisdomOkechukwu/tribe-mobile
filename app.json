{
  "expo": {
    "name": "Tribe",
    "slug": "tribe-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tribe",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F3F7",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "africa.tribe.wallet",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Tribe uses Face ID to confirm payments and unlock the app.",
        "NSCameraUsageDescription": "Tribe uses your camera to take a quick selfie and photograph your ID when you verify your identity.",
        "NSPhotoLibraryUsageDescription": "Tribe can use a photo of your ID document from your library when you verify your identity."
      }
    },
    "android": {
      "package": "africa.tribe.wallet",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3F7",
          "image": "./assets/brand/tribe-logo.png",
          "imageWidth": 140
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tribe uses your photos so you can pick a profile picture or an ID document.",
          "cameraPermission": "Tribe uses your camera to take a profile picture, scan Tribe QR codes and verify your identity."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tribe uses your camera to scan Tribe QR codes and verify your identity.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tribe uses Face ID to unlock the app and confirm payments."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Tribe saves receipts you download to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f38c3dc7-ca49-4a01-b6c2-b04912ffba5e"
      }
    }
  }
}
