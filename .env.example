# Copy to .env.local (gitignored).
# QoreID client credentials live on Tribe's backend ONLY — never put them in this app.

# Tribe backend endpoint that returns { sdkSessionToken, reference } for a KYC tier.
# Leave unset to use the built-in mock verification flow (Expo Go always uses the mock).
# EXPO_PUBLIC_KYC_SESSION_URL=https://api.tribe.example/kyc/session

# Force the mock flow even in a native build.
# EXPO_PUBLIC_KYC_PROVIDER=mock
