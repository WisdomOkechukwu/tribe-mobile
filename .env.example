# Where the app finds the Tribe API (tribe-backend). No trailing slash; the app adds /api/mobile/v1.
#   iOS Simulator / web:   http://localhost:8082
#   Android emulator:      http://10.0.2.2:8082   (the emulator's alias for your computer)
#   A real phone:          http://<your computer's LAN IP>:8082   (same Wi-Fi)
# Restart `npx expo start` after changing it (EXPO_PUBLIC_ values are inlined at build time).
EXPO_PUBLIC_API_URL=http://localhost:8082
